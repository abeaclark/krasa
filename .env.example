# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Project: hrzvqnjikgqcmnhucfbf  (https://supabase.com/dashboard/project/hrzvqnjikgqcmnhucfbf)
# Grab the exact URI from: Dashboard → Connect → "Transaction pooler" (port 6543).
# Paste your DB password where <password> is. Append ?sslmode=require in prod.
# Drizzle (db:push / db:migrate) and the API route both read this.
DATABASE_URL=postgresql://postgres.hrzvqnjikgqcmnhucfbf:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Slack ───────────────────────────────────────────────────────────────────
# Incoming Webhook URL for the channel that should receive new-lead pings.
# Create one at https://api.slack.com/messaging/webhooks
# Leave unset locally to silence notifications (lead capture still works).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
# Per-site channels (bot transport). Set SLACK_BOT_TOKEN (xoxb-…) and invite the
# bot to #leads, #krasa-ai, #local-service-group, #refund-auto and #sunlight.
# SLACK_LEADS_CHANNEL is the catch-all for sites without their own channel.
# Optional per-site override by channel ID: SLACK_CHANNEL_<SITE>, e.g.
# SLACK_CHANNEL_REFUNDAUTO_COM=C0123456789
SLACK_BOT_TOKEN=
SLACK_LEADS_CHANNEL=leads

# ─── Supabase Storage (lead document uploads) ────────────────────────────────
# Powers POST /api/leads/upload — customer paperwork attached to a lead.
# Dashboard → Project Settings → API. The service_role key is SERVER-ONLY:
# never prefix it with NEXT_PUBLIC_ and never ship it to the browser.
# Create the bucket first by running supabase/0002_lead_documents.sql.
# Leave unset locally to disable uploads (the endpoint returns 503; the funnel
# degrades to "skip upload" and everything else keeps working).
SUPABASE_URL=https://hrzvqnjikgqcmnhucfbf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEAD_DOCS_BUCKET=lead-documents

# ─── Cron (Supabase keep-alive) ──────────────────────────────────────────────
# Protects /api/cron/heartbeat. Set this to any long random string and add it as
# an env var in Vercel — Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on scheduled cron invocations.
# Generate one with: openssl rand -hex 32
# Leave unset locally to allow the endpoint without auth.
CRON_SECRET=

# ─── Client (krasadev's own contact form) ────────────────────────────────────
# Where the browser posts leads. Defaults to same-origin /api/leads, so this is
# only needed if krasadev's frontend should post somewhere else.
NEXT_PUBLIC_LEADS_ENDPOINT=/api/leads

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sends the cancellation letters and the 30/60/90-day "did your refund arrive?"
# check-ins. Create the key at https://resend.com/api-keys.
# Leave unset locally: sends are skipped and logged, everything else still works.
RESEND_API_KEY=

# Signs the one-click links in follow-up emails, so an answer can be recorded
# without a login and still can't be forged. Generate with:
#   openssl rand -hex 32
# Changing this invalidates every link already sitting in someone's inbox.
EMAIL_TOKEN_SECRET=

# Origin the one-click links in emails point at. This is the CUSTOMER-FACING
# site, not this API — refundauto.com proxies /api/outcome and /api/unsubscribe
# back here. A link to krasadev.com inside a RefundAuto email looks like
# phishing, which is fatal for an email whose whole purpose is a click.
EMAIL_LINK_ORIGIN=https://www.refundauto.com


# ─── Internal (server-to-server) ─────────────────────────────────────────────
# Shared secret that lets refundauto.com's document-analysis workflow request
# short-lived READ URLs for a customer's uploaded paperwork
# (POST /api/leads/documents/read-url). Set the SAME value as
# KRASA_INTERNAL_API_SECRET in the refundguy project. Generate with:
#   openssl rand -hex 32
INTERNAL_API_SECRET=

# ─── Email-capture popup (docs/email-capture.md) ─────────────────────────────
# Bearer secret for GET /api/capture/report (read by the portfolio dashboard).
# Unset = the report endpoint returns 503. Generate: openssl rand -hex 32
CAPTURE_REPORT_SECRET=
# Optional but recommended: when set, POST /api/subscribe (the route that sends
# reward emails) only accepts calls carrying it in `x-capture-secret`. Set the
# SAME value as KRASA_CAPTURE_SECRET in every site project.
CAPTURE_PROXY_SECRET=
# Popup brands in a DIFFERENT Resend account from RESEND_API_KEY: set
# RESEND_API_KEY_<NAME> (NAME = the domain's first label, upper-cased) to a key
# from the account where that brand's mail.<domain> is verified. Unset = the
# brand uses RESEND_API_KEY.
RESEND_API_KEY_SOLVEDPARTY=
RESEND_API_KEY_SUNDAY101=
# Signing secret Resend shows when you add the webhook
# https://www.krasadev.com/api/webhooks/resend (events: email.bounced,
# email.complained). One webhook per Resend account: put every account's
# secret here, comma-separated. Unset = the webhook refuses every call.
RESEND_WEBHOOK_SECRET=
# Slack channel (name or ID) for the 7:00 HST popup digest. Unset = the
# catch-all SLACK_LEADS_CHANNEL.
SLACK_CAPTURE_CHANNEL=
