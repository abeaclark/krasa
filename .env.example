# ─── Database (Supabase Postgres) ────────────────────────────────────────────
# Project: hrzvqnjikgqcmnhucfbf  (https://supabase.com/dashboard/project/hrzvqnjikgqcmnhucfbf)
# Grab the exact URI from: Dashboard → Connect → "Transaction pooler" (port 6543).
# Paste your DB password where <password> is. Append ?sslmode=require in prod.
# Drizzle (db:push / db:migrate) and the API route both read this.
DATABASE_URL=postgresql://postgres.hrzvqnjikgqcmnhucfbf:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ─── Slack ───────────────────────────────────────────────────────────────────
# Incoming Webhook URL for the channel that should receive new-lead pings.
# Create one at https://api.slack.com/messaging/webhooks
# Leave unset locally to silence notifications (lead capture still works).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ─── Supabase Storage (lead document uploads) ────────────────────────────────
# Powers POST /api/leads/upload — customer paperwork attached to a lead.
# Dashboard → Project Settings → API. The service_role key is SERVER-ONLY:
# never prefix it with NEXT_PUBLIC_ and never ship it to the browser.
# Create the bucket first by running supabase/0002_lead_documents.sql.
# Leave unset locally to disable uploads (the endpoint returns 503; the funnel
# degrades to "skip upload" and everything else keeps working).
SUPABASE_URL=https://hrzvqnjikgqcmnhucfbf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEAD_DOCS_BUCKET=lead-documents

# ─── Cron (Supabase keep-alive) ──────────────────────────────────────────────
# Protects /api/cron/heartbeat. Set this to any long random string and add it as
# an env var in Vercel — Vercel automatically sends it as
# `Authorization: Bearer <CRON_SECRET>` on scheduled cron invocations.
# Generate one with: openssl rand -hex 32
# Leave unset locally to allow the endpoint without auth.
CRON_SECRET=

# ─── Client (krasadev's own contact form) ────────────────────────────────────
# Where the browser posts leads. Defaults to same-origin /api/leads, so this is
# only needed if krasadev's frontend should post somewhere else.
NEXT_PUBLIC_LEADS_ENDPOINT=/api/leads
